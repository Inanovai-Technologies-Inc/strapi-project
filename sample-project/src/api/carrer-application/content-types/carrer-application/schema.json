{
  "kind": "collectionType",
  "collectionName": "carrer_applications",
  "info": {
    "singularName": "carrer-application",
    "pluralName": "carrer-applications",
    "displayName": "Carrer-Application"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "FullName": {
      "type": "string"
    },
    "Email": {
      "type": "email"
    },
    "Resume": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "CoverLetter": {
      "type": "text"
    },
    "career": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::career.career"
    },
    "Phone": {
      "type": "string"
    }
  }
}
